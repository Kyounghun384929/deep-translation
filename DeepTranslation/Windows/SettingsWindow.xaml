<Window x:Class="DeepTranslation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Translation Settings"
        Width="760" Height="600" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Pretendard, Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13">
    <Window.Resources>
        <!-- 페이지·카드 타이포그래피 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <!-- 입력란 (회색 채움, 포커스 시 파란 테두리) -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource DarkCombo}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5,28,5"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 회색 보조 버튼 -->
        <Style x:Key="Weak" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 서버 프리셋 칩 -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Weak}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 글자 버튼 (보조 동작) -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="cp" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 토글 스위치 (라벨 왼쪽, 스위치 오른쪽) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                    Background="{DynamicResource LineBrush}" BorderThickness="2" BorderBrush="Transparent">
                                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" Margin="2,0"
                                         HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세그먼트 컨트롤 (내장 / 외부 서버) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="8,6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource FieldBrush}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 왼쪽 메뉴 -->
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,0,0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- 모델 한 줄: 이름 · 배지 · 크기/라이선스 · 상태 (목록과 접힌 머리글이 같이 쓴다) -->
        <DataTemplate x:Key="ModelRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="5,0"
                        Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" ToolTip="{Binding Detail}" FontSize="12"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <TextBlock x:Name="state" Grid.Column="3" Text="{Binding State}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource SubTextBrush}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Ready}" Value="True">
                    <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 선택한 모델을 보여주는 접기/펴기 머리글 -->
        <Style x:Key="ModelHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ModelRowTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{DynamicResource FieldBrush}" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="8" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter/>
                                <Path x:Name="chev" Grid.Column="1" Data="M0,0 L4,4 L8,0" Margin="10,0,2,0"
                                      VerticalAlignment="Center" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모델 목록 (자체 스크롤 없음 — 페이지 스크롤이 휠을 받도록) -->
        <Style x:Key="ModelCards" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource ModelRowTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                            BorderThickness="1.5" CornerRadius="8" Padding="12,6" Margin="0,0,0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 메뉴 -->
        <DockPanel Margin="12,18,8,14">
            <TextBlock DockPanel.Dock="Top" Tag="nav.title" FontSize="18" FontWeight="Bold" Margin="10,0,0,12"/>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="12,0,0,0"/>
            <ListBox x:Name="NavList" Style="{StaticResource NavList}" SelectionChanged="Nav_Changed">
                <ListBoxItem><TextBlock Tag="tab.engine"/></ListBoxItem>
                <ListBoxItem><TextBlock Tag="tab.translation"/></ListBoxItem>
                <ListBoxItem><TextBlock Tag="tab.hotkey"/></ListBoxItem>
                <ListBoxItem><TextBlock Tag="tab.general"/></ListBoxItem>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 번역 엔진 -->
            <ScrollViewer x:Name="EnginePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,18,20,8">
                    <TextBlock Tag="tab.engine" Style="{StaticResource PageTitle}"/>

                    <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Margin="0,0,0,8">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="EmbeddedRadio" Tag="engine.embedded" GroupName="EngineMode"
                                         Style="{StaticResource Segment}" Checked="EngineMode_Changed"/>
                            <RadioButton x:Name="LmStudioRadio" Tag="engine.external" GroupName="EngineMode"
                                         Style="{StaticResource Segment}" Checked="EngineMode_Changed"/>
                        </UniformGrid>
                    </Border>

                    <!-- 내장 엔진 -->
                    <StackPanel x:Name="EmbeddedPanel">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Tag="engine.model" Style="{StaticResource CardTitle}"/>
                                <!-- 접힌 상태: 선택한 모델 한 줄. 누르면 전체 목록이 펼쳐지고, 고르면 다시 접힌다 -->
                                <ToggleButton x:Name="ModelToggle" Style="{StaticResource ModelHeader}"
                                              Content="{Binding SelectedItem, ElementName=ModelList}"/>
                                <ListBox x:Name="ModelList" Style="{StaticResource ModelCards}" Margin="0,4,0,0"
                                         Visibility="{Binding IsChecked, ElementName=ModelToggle, Converter={StaticResource BoolToVisibility}}"
                                         SelectionChanged="EmbeddedModel_Changed"
                                         PreviewMouseLeftButtonUp="ModelList_MouseUp"/>

                                <!-- 선택한 모델의 동작 -->
                                <StackPanel x:Name="CatalogActions" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DownloadButton" Style="{StaticResource Primary}" Click="Download_Click"/>
                                        <ProgressBar x:Name="DownloadBar" Grid.Column="1" Style="{StaticResource Progress}"
                                                     Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Button x:Name="DeleteModelButton" Grid.Column="2" Tag="engine.delete"
                                                Style="{StaticResource Weak}" Click="DeleteModel_Click"/>
                                    </Grid>
                                </StackPanel>
                                <Grid x:Name="CustomActions" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CustomPathBox" Style="{StaticResource Field}" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Tag="custom.browse" Style="{StaticResource Weak}"
                                            Margin="8,0,0,0" Click="BrowseCustom_Click"/>
                                </Grid>
                                <TextBlock x:Name="DownloadStatus" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Tag="engine.binary" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="BackendInfo" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="EngineDownloadButton" Grid.Column="1" Style="{StaticResource Weak}"
                                            Click="EngineDownload_Click"/>
                                </Grid>
                                <ProgressBar x:Name="EngineDownloadBar" Style="{StaticResource Progress}" Margin="0,12,0,0"
                                             Visibility="Collapsed"/>
                                <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}"/>
                                <WrapPanel>
                                    <Button x:Name="RetryGpuButton" Tag="engine.gpu.retry" Style="{StaticResource Link}"
                                            Click="RetryGpu_Click"/>
                                    <Button x:Name="ResetVersionButton" Tag="engine.version.reset" Style="{StaticResource Link}"
                                            Click="ResetVersion_Click"/>
                                </WrapPanel>

                                <Border Style="{StaticResource Divider}"/>

                                <Grid x:Name="ContextRow" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Tag="engine.context" Style="{StaticResource Label}"/>
                                        <TextBlock Tag="engine.context.hint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ContextBox" Grid.Column="1" Style="{StaticResource Combo}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Tag="engine.idle" Style="{StaticResource Label}"/>
                                        <TextBlock Tag="engine.idle.hint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="IdleUnloadBox" Grid.Column="1" Style="{StaticResource Combo}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 외부 서버 -->
                    <StackPanel x:Name="LmStudioPanel">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Tag="server.url" Style="{StaticResource CardTitle}" Margin="0"
                                               VerticalAlignment="Center"/>
                                    <Button Tag="server.detect" Style="{StaticResource Link}" Margin="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="Detect_Click"/>
                                </Grid>
                                <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10">
                                    <Button Content="LM Studio" CommandParameter="http://localhost:1234"
                                            Style="{StaticResource Chip}" Click="Preset_Click"/>
                                    <Button Content="Ollama" CommandParameter="http://localhost:11434"
                                            Style="{StaticResource Chip}" Click="Preset_Click"/>
                                    <Button Content="llama-server" CommandParameter="http://localhost:8080"
                                            Style="{StaticResource Chip}" Click="Preset_Click"/>
                                    <Button Content="vLLM" CommandParameter="http://localhost:8000"
                                            Style="{StaticResource Chip}" Click="Preset_Click"/>
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerBox" Style="{StaticResource Field}"/>
                                    <Button Grid.Column="1" Tag="server.test" Style="{StaticResource Weak}"
                                            Margin="8,0,0,0" Click="Test_Click"/>
                                </Grid>
                                <TextBlock x:Name="ServerStatus" Style="{StaticResource Hint}"/>

                                <Border Style="{StaticResource Divider}"/>

                                <TextBlock Tag="server.apikey" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <TextBox x:Name="ApiKeyBox" Style="{StaticResource Field}"/>
                                <TextBlock Tag="server.apikey.hint" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Tag="server.model" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelBox" Style="{StaticResource Combo}"/>
                                    <Button Grid.Column="1" Tag="server.refresh" Style="{StaticResource Weak}"
                                            Margin="8,0,0,0" Click="Refresh_Click"/>
                                </Grid>
                                <TextBlock Tag="server.model.hint" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. 번역 -->
            <ScrollViewer x:Name="TranslationPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="4,18,20,8">
                    <TextBlock Tag="tab.translation" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Tag="target" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="TargetBox" Grid.Column="1" Style="{StaticResource Combo}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Tag="target.korean" Style="{StaticResource Label}"/>
                                    <TextBlock Tag="target.korean.tip" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="KoreanSourceBox" Grid.Column="1" Style="{StaticResource Combo}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Tag="glossary" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Tag="glossary.hint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <TextBox x:Name="GlossaryBox" Style="{StaticResource Field}" Height="200"
                                     VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Malgun Gothic" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 단축키 -->
            <ScrollViewer x:Name="HotkeyPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="4,18,20,8">
                    <TextBlock Tag="tab.hotkey" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Tag="hotkey" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyBox" Tag="hotkey.box" Style="{StaticResource Field}" IsReadOnly="True"
                                         Cursor="Hand" InputMethod.IsInputMethodEnabled="False" FontWeight="SemiBold"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                <Button Grid.Column="1" Tag="hotkey.reset" Style="{StaticResource Weak}"
                                        Margin="8,0,0,0" Click="HotkeyReset_Click"/>
                            </Grid>
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"/>

                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox x:Name="DoublePressCheck" Tag="hotkey.double" Style="{StaticResource Switch}"
                                      Checked="DoublePress_Changed" Unchecked="DoublePress_Changed" Margin="0,0,0,12"/>
                            <CheckBox x:Name="HotkeyCheck" Tag="hotkey.enabled" Style="{StaticResource Switch}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. 일반 -->
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="4,18,20,8">
                    <TextBlock Tag="tab.general" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Tag="appearance" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Tag="ui.language" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="UiLanguageBox" Grid.Column="1" Style="{StaticResource Combo}"
                                          SelectionChanged="UiLanguage_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Tag="popup.theme" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource Combo}"/>
                            </Grid>
                            <CheckBox x:Name="CursorCheck" Tag="popup.cursor" Style="{StaticResource Switch}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="FocusCheck" Tag="popup.focus" Style="{StaticResource Switch}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Tag="startup" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="StartupCheck" Tag="startup.run" Style="{StaticResource Switch}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="UpdateCheck" Tag="startup.update" Style="{StaticResource Switch}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 하단 버튼 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,20,14">
                <Button Tag="cancel" Style="{StaticResource Weak}" MinWidth="96" IsCancel="True"/>
                <Button Tag="save" Style="{StaticResource Primary}" MinWidth="96" Margin="8,0,0,0"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
