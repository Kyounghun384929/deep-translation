<Window x:Class="DeepTranslation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Translation 설정"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="번역 엔진" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="EmbeddedRadio" Content="내장 모델 (권장)" GroupName="EngineMode"
                         Checked="EngineMode_Changed"/>
            <RadioButton x:Name="LmStudioRadio" Content="LM Studio 서버" GroupName="EngineMode"
                         Margin="18,0,0,0" Checked="EngineMode_Changed"/>
        </StackPanel>

        <StackPanel x:Name="EmbeddedPanel">
            <TextBlock x:Name="BackendInfo" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="EngineDownloadButton" Grid.Column="0" Content="엔진 다운로드" Padding="12,5"
                        Click="EngineDownload_Click"/>
                <ProgressBar x:Name="EngineDownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="EngineStatus" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                       Margin="0,3,0,10"/>
            <ComboBox x:Name="EmbeddedModelBox" Padding="6,5" VerticalContentAlignment="Center"
                      SelectionChanged="EmbeddedModel_Changed"/>
            <TextBlock x:Name="EmbeddedLicense" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                       Margin="0,5,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DownloadButton" Grid.Column="0" Content="다운로드" Padding="12,5"
                        Click="Download_Click"/>
                <ProgressBar x:Name="DownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="DeleteModelButton" Grid.Column="2" Content="삭제" Padding="12,5"
                        Click="DeleteModel_Click"/>
            </Grid>
            <TextBlock x:Name="DownloadStatus" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                       Margin="0,5,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="유휴 시 메모리 회수:" VerticalAlignment="Center"
                           ToolTip="번역이 없으면 모델을 메모리에서 내립니다. 다음 번역 때 자동으로 다시 켜집니다."/>
                <ComboBox x:Name="IdleUnloadBox" Margin="8,0,0,0" Padding="6,3" MinWidth="110"
                          VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="LmStudioPanel">
            <TextBlock Text="LM Studio 서버" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerBox" Grid.Column="0" Padding="6,5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="연결 테스트" Margin="8,0,0,0" Padding="12,5" Click="Test_Click"/>
            </Grid>
            <TextBlock x:Name="ServerStatus" Foreground="Gray" FontSize="12" Margin="0,5,0,14"
                       Text="예: http://localhost:1234" TextWrapping="Wrap"/>

            <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelBox" Grid.Column="0" Padding="6,5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="새로고침" Margin="8,0,0,0" Padding="12,5" Click="Refresh_Click"/>
            </Grid>
        </StackPanel>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="번역 대상 언어" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="TargetBox" Padding="6,5" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="원문이 이미 한국어이면" FontWeight="SemiBold" Margin="0,0,0,6"
                           ToolTip="복사한 텍스트가 이미 한국어일 때 대신 번역할 언어"/>
                <ComboBox x:Name="KoreanSourceBox" Padding="6,5" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="용어집" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="GlossaryBox" Height="70" Padding="6,5"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Malgun Gothic"/>
        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"
                   Text="한 줄에 하나: 원어 = 번역어 (예: LM Studio = LM Studio)"/>

        <TextBlock Text="번역 단축키" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" Grid.Column="0" IsReadOnly="True" Padding="6,5"
                     VerticalContentAlignment="Center" Cursor="Hand"
                     InputMethod.IsInputMethodEnabled="False"
                     ToolTip="클릭한 뒤 원하는 키 조합을 누르세요"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <CheckBox x:Name="DoublePressCheck" Grid.Column="1" Content="두 번 누르기"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="DoublePress_Changed" Unchecked="DoublePress_Changed"/>
            <Button Grid.Column="2" Content="기본값" Margin="10,0,0,0" Padding="10,5" Click="HotkeyReset_Click"/>
        </Grid>
        <TextBlock x:Name="HotkeyHint" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="입력란을 클릭한 뒤 원하는 키 조합을 누르세요."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="번역 창 테마:" VerticalAlignment="Center"
                       ToolTip="시스템 기본은 Windows의 라이트/다크 설정을 따릅니다"/>
            <ComboBox x:Name="ThemeBox" Margin="8,0,0,0" Padding="6,3" MinWidth="110"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <CheckBox x:Name="HotkeyCheck" Content="단축키 사용" Margin="0,0,0,9"/>
        <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 자동 실행" Margin="0,0,0,9"/>
        <CheckBox x:Name="UpdateCheck" Content="새 버전 자동 확인 (하루 1회)" Margin="0,0,0,9"
                  ToolTip="GitHub Releases에서 새 버전을 확인하고 트레이 알림으로 알려줍니다"/>
        <CheckBox x:Name="CursorCheck" Content="번역 창을 마우스 커서 근처에 표시" Margin="0,0,0,9"/>
        <CheckBox x:Name="FocusCheck" Content="창 밖을 클릭하면 번역 창 닫기" Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="저장" Width="86" Padding="0,6" Click="Save_Click" IsDefault="True"/>
            <Button Content="취소" Width="86" Padding="0,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
