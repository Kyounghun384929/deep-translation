<Window x:Class="DeepTranslation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Translation 설정"
        Width="480" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="저장" Width="86" Padding="0,6" Click="Save_Click" IsDefault="True"/>
            <Button Content="취소" Width="86" Padding="0,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TabControl Padding="14,12">

            <!-- 1. 번역 엔진 -->
            <TabItem Header="번역 엔진">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="EmbeddedRadio" Content="내장 모델 (권장)" GroupName="EngineMode"
                                         Checked="EngineMode_Changed"/>
                            <RadioButton x:Name="LmStudioRadio" Content="외부 서버 (OpenAI 호환)" GroupName="EngineMode"
                                         Margin="18,0,0,0" Checked="EngineMode_Changed"/>
                        </StackPanel>

                        <StackPanel x:Name="EmbeddedPanel">
                            <TextBlock Text="모델" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="EmbeddedModelBox" Style="{StaticResource Field}"
                                      SelectionChanged="EmbeddedModel_Changed"/>
                            <TextBlock x:Name="EmbeddedLicense" Style="{StaticResource Hint}" Margin="0,5,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DownloadButton" Grid.Column="0" Content="다운로드" Padding="12,5"
                                        Click="Download_Click"/>
                                <ProgressBar x:Name="DownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Button x:Name="DeleteModelButton" Grid.Column="2" Content="삭제"
                                        Style="{StaticResource Action}" Click="DeleteModel_Click"/>
                            </Grid>
                            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Hint}"/>

                            <TextBlock Text="엔진" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="BackendInfo" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EngineDownloadButton" Grid.Column="0" Content="엔진 다운로드" Padding="12,5"
                                        Click="EngineDownload_Click"/>
                                <ProgressBar x:Name="EngineDownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}" Margin="0,3,0,14"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="유휴 시 메모리 회수:" VerticalAlignment="Center"
                                           ToolTip="번역이 없으면 모델을 메모리에서 내립니다. 다음 번역 때 자동으로 다시 켜집니다."/>
                                <ComboBox x:Name="IdleUnloadBox" Margin="8,0,0,0" Padding="6,3" MinWidth="110"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="LmStudioPanel">
                            <TextBlock Text="서버 주소" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServerBox" Grid.Column="0" Style="{StaticResource Field}"/>
                                <Button Grid.Column="1" Content="연결 테스트" Style="{StaticResource Action}" Click="Test_Click"/>
                            </Grid>
                            <TextBlock x:Name="ServerStatus" Style="{StaticResource Hint}"
                                       Text="LM Studio: http://localhost:1234 · Ollama: http://localhost:11434/v1"/>

                            <TextBlock Text="API 키 (선택)" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="ApiKeyBox" Style="{StaticResource Field}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="서버가 API 키를 요구할 때만 입력하세요. 키는 위 서버로만 전송됩니다."/>

                            <TextBlock Text="모델" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModelBox" Grid.Column="0" Style="{StaticResource Field}" IsEditable="True"/>
                                <Button Grid.Column="1" Content="새로고침" Style="{StaticResource Action}" Click="Refresh_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 번역 -->
            <TabItem Header="번역">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="번역 대상 언어" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="TargetBox" Style="{StaticResource Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="원문이 이미 한국어이면" Style="{StaticResource SectionTitle}"
                                       ToolTip="복사한 텍스트가 이미 한국어일 때 대신 번역할 언어"/>
                            <ComboBox x:Name="KoreanSourceBox" Style="{StaticResource Field}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="용어집" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="GlossaryBox" Height="200" Padding="6,5"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Malgun Gothic"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="한 줄에 하나: 원어 = 번역어 (예: LM Studio = LM Studio)"/>
                </StackPanel>
            </TabItem>

            <!-- 3. 단축키·창 -->
            <TabItem Header="단축키 · 창">
                <StackPanel>
                    <TextBlock Text="번역 단축키" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox" Grid.Column="0" Style="{StaticResource Field}" IsReadOnly="True"
                                 Cursor="Hand" InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="클릭한 뒤 원하는 키 조합을 누르세요"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <CheckBox x:Name="DoublePressCheck" Grid.Column="1" Content="두 번 누르기"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="DoublePress_Changed" Unchecked="DoublePress_Changed"/>
                        <Button Grid.Column="2" Content="기본값" Style="{StaticResource Action}" Padding="10,5"
                                Click="HotkeyReset_Click"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="입력란을 클릭한 뒤 원하는 키 조합을 누르세요."/>
                    <CheckBox x:Name="HotkeyCheck" Content="단축키 사용" Margin="0,0,0,18"/>

                    <TextBlock Text="번역 창" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="테마:" VerticalAlignment="Center"
                                   ToolTip="시스템 기본은 Windows의 라이트/다크 설정을 따릅니다"/>
                        <ComboBox x:Name="ThemeBox" Margin="8,0,0,0" Padding="6,3" MinWidth="110"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="CursorCheck" Content="마우스 커서 근처에 표시"/>
                    <CheckBox x:Name="FocusCheck" Content="창 밖을 클릭하면 닫기" Margin="0,0,0,18"/>

                    <TextBlock Text="일반" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 자동 실행"/>
                    <CheckBox x:Name="UpdateCheck" Content="새 버전 자동 확인 (하루 1회)"
                              ToolTip="GitHub Releases에서 새 버전을 확인하고 트레이 알림으로 알려줍니다"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
