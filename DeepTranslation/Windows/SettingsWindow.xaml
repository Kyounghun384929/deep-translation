<Window x:Class="DeepTranslation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Translation Settings"
        Width="480" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="Inline" TargetType="ComboBox">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Tag="save" Width="86" Padding="0,6" Click="Save_Click" IsDefault="True"/>
            <Button Tag="cancel" Width="86" Padding="0,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TabControl Padding="14,12">

            <!-- 1. 번역 엔진 -->
            <TabItem Tag="tab.engine">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="EmbeddedRadio" Tag="engine.embedded" GroupName="EngineMode"
                                         Checked="EngineMode_Changed"/>
                            <RadioButton x:Name="LmStudioRadio" Tag="engine.external" GroupName="EngineMode"
                                         Margin="18,0,0,0" Checked="EngineMode_Changed"/>
                        </StackPanel>

                        <StackPanel x:Name="EmbeddedPanel">
                            <TextBlock Tag="engine.model" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="EmbeddedModelBox" Style="{StaticResource Field}"
                                      SelectionChanged="EmbeddedModel_Changed"/>
                            <TextBlock x:Name="EmbeddedLicense" Style="{StaticResource Hint}" Margin="0,5,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DownloadButton" Grid.Column="0" Padding="12,5" Click="Download_Click"/>
                                <ProgressBar x:Name="DownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Button x:Name="DeleteModelButton" Grid.Column="2" Tag="engine.delete"
                                        Style="{StaticResource Action}" Click="DeleteModel_Click"/>
                            </Grid>
                            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Hint}"/>

                            <TextBlock Tag="engine.binary" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="BackendInfo" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EngineDownloadButton" Grid.Column="0" Padding="12,5"
                                        Click="EngineDownload_Click"/>
                                <ProgressBar x:Name="EngineDownloadBar" Grid.Column="1" Height="10" Margin="8,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}" Margin="0,3,0,14"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Tag="engine.idle" VerticalAlignment="Center"/>
                                <ComboBox x:Name="IdleUnloadBox" Style="{StaticResource Inline}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="LmStudioPanel">
                            <TextBlock Tag="server.url" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ServerBox" Grid.Column="0" Style="{StaticResource Field}" IsEditable="True"/>
                                <Button Grid.Column="1" Tag="server.test" Style="{StaticResource Action}" Click="Test_Click"/>
                            </Grid>
                            <TextBlock x:Name="ServerStatus" Tag="server.hint" Style="{StaticResource Hint}"/>

                            <TextBlock Tag="server.apikey" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="ApiKeyBox" Style="{StaticResource Field}"/>
                            <TextBlock Tag="server.apikey.hint" Style="{StaticResource Hint}"/>

                            <TextBlock Tag="server.model" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModelBox" Grid.Column="0" Style="{StaticResource Field}" IsEditable="True"/>
                                <Button Grid.Column="1" Tag="server.refresh" Style="{StaticResource Action}" Click="Refresh_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 번역 -->
            <TabItem Tag="tab.translation">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Tag="target" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="TargetBox" Style="{StaticResource Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Tag="target.korean" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="KoreanSourceBox" Style="{StaticResource Field}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Tag="glossary" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="GlossaryBox" Height="200" Padding="6,5"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Malgun Gothic"/>
                    <TextBlock Tag="glossary.hint" Style="{StaticResource Hint}"/>
                </StackPanel>
            </TabItem>

            <!-- 3. 일반 -->
            <TabItem Tag="tab.general">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Tag="ui.language" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UiLanguageBox" Style="{StaticResource Inline}"
                                  SelectionChanged="UiLanguage_Changed"/>
                    </StackPanel>

                    <TextBlock Tag="hotkey" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox" Grid.Column="0" Style="{StaticResource Field}" IsReadOnly="True"
                                 Cursor="Hand" InputMethod.IsInputMethodEnabled="False"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <CheckBox x:Name="DoublePressCheck" Grid.Column="1" Tag="hotkey.double"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="DoublePress_Changed" Unchecked="DoublePress_Changed"/>
                        <Button Grid.Column="2" Tag="hotkey.reset" Style="{StaticResource Action}" Padding="10,5"
                                Click="HotkeyReset_Click"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="HotkeyCheck" Tag="hotkey.enabled" Margin="0,0,0,18"/>

                    <TextBlock Tag="popup" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Tag="popup.theme" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeBox" Style="{StaticResource Inline}"/>
                    </StackPanel>
                    <CheckBox x:Name="CursorCheck" Tag="popup.cursor"/>
                    <CheckBox x:Name="FocusCheck" Tag="popup.focus" Margin="0,0,0,18"/>

                    <TextBlock Tag="startup" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="StartupCheck" Tag="startup.run"/>
                    <CheckBox x:Name="UpdateCheck" Tag="startup.update"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
