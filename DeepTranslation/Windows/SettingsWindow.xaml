<Window x:Class="DeepTranslation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Translation 설정"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="LM Studio 서버" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ServerBox" Grid.Column="0" Padding="6,5" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="연결 테스트" Margin="8,0,0,0" Padding="12,5" Click="Test_Click"/>
        </Grid>
        <TextBlock x:Name="ServerStatus" Foreground="Gray" FontSize="12" Margin="0,5,0,14"
                   Text="예: http://localhost:1234" TextWrapping="Wrap"/>

        <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelBox" Grid.Column="0" Padding="6,5" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="새로고침" Margin="8,0,0,0" Padding="12,5" Click="Refresh_Click"/>
        </Grid>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="번역 대상 언어" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="TargetBox" Padding="6,5" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="원문이 이미 한국어이면" FontWeight="SemiBold" Margin="0,0,0,6"
                           ToolTip="복사한 텍스트가 이미 한국어일 때 대신 번역할 언어"/>
                <ComboBox x:Name="KoreanSourceBox" Padding="6,5" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="번역 단축키" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox" Grid.Column="0" IsReadOnly="True" Padding="6,5"
                     VerticalContentAlignment="Center" Cursor="Hand"
                     InputMethod.IsInputMethodEnabled="False"
                     ToolTip="클릭한 뒤 원하는 키 조합을 누르세요"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <CheckBox x:Name="DoublePressCheck" Grid.Column="1" Content="두 번 누르기"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="DoublePress_Changed" Unchecked="DoublePress_Changed"/>
            <Button Grid.Column="2" Content="기본값" Margin="10,0,0,0" Padding="10,5" Click="HotkeyReset_Click"/>
        </Grid>
        <TextBlock x:Name="HotkeyHint" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="입력란을 클릭한 뒤 원하는 키 조합을 누르세요."/>

        <CheckBox x:Name="HotkeyCheck" Content="단축키 사용" Margin="0,0,0,9"/>
        <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 자동 실행" Margin="0,0,0,9"/>
        <CheckBox x:Name="CursorCheck" Content="번역 창을 마우스 커서 근처에 표시" Margin="0,0,0,9"/>
        <CheckBox x:Name="FocusCheck" Content="창 밖을 클릭하면 번역 창 닫기" Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="저장" Width="86" Padding="0,6" Click="Save_Click" IsDefault="True"/>
            <Button Content="취소" Width="86" Padding="0,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
